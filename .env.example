# Eyes of Horus — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === REQUIRED ===

# Telegram Bot (get these from @BotFather and @userinfobot on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Anthropic API key for Claude Vision (premium image descriptions)
# Leave empty to use local Ollama vision model instead (free)
ANTHROPIC_API_KEY=

# Google Gemini API key for cloud vision descriptions (free tier available)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key for fast cloud vision (free tier: 30 req/min)
# Get from: https://console.groq.com
GROQ_API_KEY=

# OpenRouter API key for cloud LLM (vision + text)
OPENROUTER_API_KEY=

# Redis connection (leave empty to use in-process event bus)
# Redis enables scene memory and distributed event streaming
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# === ROBOFLOW INFERENCE (detection + segmentation) ===

# Required for SAM3 serverless and any Roboflow Universe models
# Get from: https://app.roboflow.com → Settings → API Keys
ROBOFLOW_API_KEY=

# Optional URL overrides — defaults work for local dev
# ROBOFLOW_SERVER_URL=http://localhost:9001
# ROBOFLOW_SEGMENTATION_PROVIDER=serverless
# ROBOFLOW_SEGMENTATION_LOCAL_URL=http://localhost:9001
# ROBOFLOW_SEGMENTATION_SERVERLESS_URL=https://serverless.roboflow.com

# === LOCAL LLM ===

# Ollama host (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# === SUPABASE (cloud sync + dashboard) ===

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=CLIPS

# === EMBEDDINGS (for clip search) ===

# Jina embeddings API key (default provider)
JINA_API_KEY=

# === ENVIRONMENT + LOGGING ===

# "development" = verbose logs (default)
# "production" = third-party libs silenced, access logs disabled
# STANGWATCH_ENV=development

# Override site.log_level from config.yaml
# LOG_LEVEL=INFO

# === CAMERA CREDENTIALS ===

# Convention: CAMERA_{NAME}_{FIELD} where name matches config.yaml
# Example for a camera named "front gate":
# CAMERA_FRONT_GATE_USER=admin
# CAMERA_FRONT_GATE_PASSWORD=secretpass123
