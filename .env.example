# Eyes of Horus — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === REQUIRED ===

# Telegram Bot (get these from @BotFather and @userinfobot on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Anthropic API key for Claude Vision (premium image descriptions)
# Leave empty to use local Ollama vision model instead (free)
ANTHROPIC_API_KEY=

# Google Gemini API key for cloud vision descriptions (free tier available)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key for fast cloud vision (free tier: 30 req/min)
# Get from: https://console.groq.com
GROQ_API_KEY=

# Redis connection (leave empty to use in-process event bus)
# Redis enables scene memory and distributed event streaming
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# Camera credentials (for IP cameras with authentication)
# Convention: CAMERA_{NAME}_{FIELD} where name matches config.yaml
# Example for a camera named "front gate":
# CAMERA_FRONT_GATE_USER=admin
# CAMERA_FRONT_GATE_PASSWORD=secretpass123

# WhatsApp Cloud API (Meta Graph) — optional parallel alert channel
# Get these from developers.facebook.com → your WhatsApp Business app
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Verify token: any random string you choose; paste the same value into
# the Meta webhook config so the GET /whatsapp/webhook handshake succeeds.
WHATSAPP_VERIFY_TOKEN=
# App secret from your Meta app (used to validate X-Hub-Signature-256 on
# incoming webhooks). Required to receive button-press feedback safely.
WHATSAPP_APP_SECRET=
# Comma-separated list of E.164 numbers that should receive every alert.
# Example: WHATSAPP_RECIPIENTS=+2348012345678,+2348123456789
WHATSAPP_RECIPIENTS=
